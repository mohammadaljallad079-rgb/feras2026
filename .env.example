# Copy to .env and set real values. Never commit the filled file.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=safir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=safir

# --- Backend ----------------------------------------------------------------
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
STORAGE_DIR=/var/lib/safir/storage
CORS_ORIGINS=http://localhost:8080

# --- AI provider (optional) -------------------------------------------------
# Leave OPENAI_API_KEY empty to run with the assistant in "unconfigured" state.
# The platform reports that state plainly; it never fabricates an answer.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Reverse proxy ----------------------------------------------------------
HTTP_PORT=8080
