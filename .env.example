# Copy to .env and set real values. Never commit the filled file.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=safir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=safir

# --- Backend ----------------------------------------------------------------
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-value
STORAGE_DIR=/var/lib/safir/storage
CORS_ORIGINS=http://localhost:8080

# Public URL of the frontend, used to build the secure links in account emails.
FRONTEND_BASE_URL=http://localhost:8080

# --- Outbound mail (optional) -----------------------------------------------
# Leave SMTP_HOST empty to run without mail. Account links are then returned to
# the caller so they can be delivered out-of-band; the platform never claims a
# message it did not send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@safir-platform.com
SMTP_USE_TLS=true

# --- AI provider (optional) -------------------------------------------------
# Leave OPENAI_API_KEY empty to run with the assistant in "unconfigured" state.
# The platform reports that state plainly; it never fabricates an answer.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Reverse proxy ----------------------------------------------------------
HTTP_PORT=8080
