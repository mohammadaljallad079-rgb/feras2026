# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://safir:safir@localhost:5432/safir
SECRET_KEY=change-me-in-production
STORAGE_DIR=/var/lib/safir/storage
MAX_UPLOAD_BYTES=20971520
CORS_ORIGINS=http://localhost:3000
PUBLIC_RATE_LIMIT_PER_HOUR=20

# AI provider (approved provider is OpenAI; selected through configuration).
# With no key the assistant returns a clear configuration status and never a
# fabricated answer. The owner can also set the key on the assistant screen,
# which is stored server-side and never returned by the API.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_CLASSES=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1
OPENAI_API_KEY=
