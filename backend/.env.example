# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://safir:safir@127.0.0.1:5432/safir
SECRET_KEY=change-me-in-production
STORAGE_DIR=/var/lib/safir/storage
MAX_UPLOAD_BYTES=20971520
CORS_ORIGINS=http://localhost:3000
PUBLIC_RATE_LIMIT_PER_HOUR=20

# AI provider (approved provider is OpenAI; selected through configuration).
# With no key the assistant returns a clear configuration status and never a
# fabricated answer. The owner can also set the key on the assistant screen,
# which is stored server-side and never returned by the API.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_CLASSES=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1
OPENAI_API_KEY=

# Outbound mail. With SMTP_HOST empty no mail is sent and the sender reports
# False rather than claiming a delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@safir-platform.com
SMTP_USE_TLS=true

# Public frontend URL, used to build the secure links in account emails.
FRONTEND_BASE_URL=http://localhost:3000

# Timezone in which report-deadline reminders resolve "today" (cron runs once a
# day; the due dates are Bahrain business dates).
REMINDERS_TIMEZONE=Asia/Bahrain
